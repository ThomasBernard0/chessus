generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lobby {
  id        String      @id @default(cuid())
  code      String      @unique
  hostId    String
  status    LobbyStatus @default(WAITING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  players   Player[]
  game      Game?
}

model Player {
  id            String   @id @default(cuid())
  username      String
  socketId      String?  @unique
  lobbyId       String?
  team          Team?
  seatIndex     Int? // 0-3 determines turn order within a team
  isHost        Boolean  @default(false)
  isImposter    Boolean  @default(false)
  points        Int      @default(0)
  createdAt     DateTime @default(now())
  lobby         Lobby?   @relation(fields: [lobbyId], references: [id])
  movesPlayed   Move[]
  votesGiven    Vote[]   @relation("voter")
  votesReceived Vote[]   @relation("suspect")
}

model Game {
  id        String     @id @default(cuid())
  lobbyId   String     @unique
  lobby     Lobby      @relation(fields: [lobbyId], references: [id])
  pgn       String     @default("")
  fen       String     @default("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1")
  status    GameStatus @default(IN_PROGRESS)
  winner    Team?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  moves     Move[]
  votes     Vote[]
}

model Move {
  id        String   @id @default(cuid())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id])
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id])
  from      String
  to        String
  promotion String?
  san       String
  fen       String // board state after this move
  createdAt DateTime @default(now())
}

model Vote {
  id        String   @id @default(cuid())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id])
  voterId   String
  voter     Player   @relation("voter", fields: [voterId], references: [id])
  suspectId String
  suspect   Player   @relation("suspect", fields: [suspectId], references: [id])
  createdAt DateTime @default(now())

  @@unique([gameId, voterId])
}

enum LobbyStatus {
  WAITING
  IN_PROGRESS
  FINISHED
}

enum GameStatus {
  IN_PROGRESS
  VOTING
  FINISHED
}

enum Team {
  A
  B
}
